{
  "manifest_version": 3,
  "name": "Web Tempo Sync (prototype)",
  "version": "0.2.0",
  "description": "Adds navigator.tempoSync to secure pages, joining Link sessions on the local network through the tempo-sync-host helper.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_title": "Web Tempo Sync", "default_popup": "popup.html" }
}
