+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class ExceptionState;
+class Navigator;
+class ScriptState;
+class TempoSession;
+class TempoSessionOptions;
+
+class TempoSync final : public ScriptWrappable,
+                        public ExecutionContextLifecycleObserver {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  explicit TempoSync(Navigator* navigator);
+
+  // WebIDL
+  ScriptPromise<TempoSession> requestSession(ScriptState* script_state,
+                                             const TempoSessionOptions* options,
+                                             ExceptionState& exception_state);
+
+  void Trace(Visitor* visitor) const override;
+
+  // ExecutionContextLifecycleObserver
+  void ContextDestroyed() override;
+
+ private:
+  void OnSessionRequested(ScriptPromiseResolver<TempoSession>* resolver,
+                          TempoSession* session,
+                          mojo::PendingRemote<mojom::blink::TempoSession> session_remote,
+                          mojom::blink::TimelinePtr timeline,
+                          mojom::blink::StartStopStatePtr start_stop,
+                          uint32_t num_peers,
+                          const String& error_message);
+
+  HeapMojoRemote<mojom::blink::TempoSyncService> service_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_TEMPO_SYNC_TEMPO_SYNC_H_
