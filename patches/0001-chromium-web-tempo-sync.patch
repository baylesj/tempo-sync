+#include "third_party/blink/renderer/modules/tempo_sync/navigator_tempo_sync.h"
+
+#include "third_party/blink/renderer/core/frame/navigator.h"
+#include "third_party/blink/renderer/modules/tempo_sync/tempo_sync.h"
+
+namespace blink {
+
+const char NavigatorTempoSync::kSupplementName[] = "NavigatorTempoSync";
+
+NavigatorTempoSync& NavigatorTempoSync::From(Navigator& navigator) {
+  NavigatorTempoSync* supplement =
+      Supplement<Navigator>::From<NavigatorTempoSync>(navigator);
+  if (!supplement) {
+    supplement = MakeGarbageCollected<NavigatorTempoSync>(navigator);
+    ProvideTo(navigator, supplement);
+  }
+  return *supplement;
+}
+
+TempoSync* NavigatorTempoSync::tempoSync(Navigator& navigator) {
+  return NavigatorTempoSync::From(navigator).tempoSync();
+}
+
+NavigatorTempoSync::NavigatorTempoSync(Navigator& navigator)
+    : Supplement<Navigator>(navigator) {}
+
+TempoSync* NavigatorTempoSync::tempoSync() {
+  if (!tempo_sync_) {
+    tempo_sync_ = MakeGarbageCollected<TempoSync>(GetSupplementable());
+  }
+  return tempo_sync_.Get();
+}
+
+void NavigatorTempoSync::Trace(Visitor* visitor) const {
+  visitor->Trace(tempo_sync_);
+  Supplement<Navigator>::Trace(visitor);
+}
+
+}  // namespace blink
