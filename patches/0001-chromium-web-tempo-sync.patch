@@ -0,0 +1,57 @@
+#include "content/browser/tempo_sync/fake_tempo_sync_engine.h"
+
+namespace content {
+
+FakeTempoSyncEngine::FakeTempoSyncEngine() {
+  timeline_ = blink::mojom::Timeline::New();
+  timeline_->tempo_bpm = 120.0;
+  timeline_->beat_origin = 0.0;
+  timeline_->time_origin = base::TimeTicks::Now();
+
+  start_stop_ = blink::mojom::StartStopState::New();
+  start_stop_->is_playing = true;
+  start_stop_->beat = 0.0;
+  start_stop_->time = base::TimeTicks::Now();
+}
+
+FakeTempoSyncEngine::~FakeTempoSyncEngine() = default;
+
+void FakeTempoSyncEngine::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+  observer->OnTimelineChanged(timeline_->Clone());
+  observer->OnStartStopChanged(start_stop_->Clone());
+  observer->OnNumPeersChanged(num_peers_);
+}
+
+void FakeTempoSyncEngine::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void FakeTempoSyncEngine::SetTimeline(blink::mojom::TimelinePtr timeline) {
+  timeline_ = std::move(timeline);
+  for (auto& observer : observers_) {
+    observer.OnTimelineChanged(timeline_->Clone());
+  }
+}
+
+void FakeTempoSyncEngine::SetStartStop(blink::mojom::StartStopStatePtr state) {
+  start_stop_ = std::move(state);
+  for (auto& observer : observers_) {
+    observer.OnStartStopChanged(start_stop_->Clone());
+  }
+}
+
+
+blink::mojom::TimelinePtr FakeTempoSyncEngine::GetTimeline() const {
+  return timeline_->Clone();
+}
+
+blink::mojom::StartStopStatePtr FakeTempoSyncEngine::GetStartStop() const {
+  return start_stop_->Clone();
+}
+
+uint32_t FakeTempoSyncEngine::GetNumPeers() const {
+  return num_peers_;
+}
+
+}  // namespace content
