diff --git a/content/browser/tempo_sync/rust_tempo_sync_bridge.rs b/content/browser/tempo_sync/rust_tempo_sync_bridge.rs
new file mode 100644
index 0000000000000..438790e1c887d
--- /dev/null
+++ b/content/browser/tempo_sync/rust_tempo_sync_bridge.rs
@@ -0,0 +1,215 @@
+#![allow(warnings)]
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use cxx::CxxVector;
+use std::net::Ipv4Addr;
+use tempo_sync_core::{Engine, Output, InterfaceId, SocketAddrPlain, NodeId};
+use tempo_sync_core::time::{HostTime, Tempo, MicroBeats, TempoWire};
+use tempo_sync_core::timeline::{Timeline, StartStopState, SessionState};
+
+#[cxx::bridge(namespace = "content::tempo_sync_bridge")]
+pub mod ffi {
+    struct TimelineData {
+        tempo: f64,
+        beat_origin: f64,
+        time_origin_micros: i64,
+    }
+
+    struct StartStopData {
+        is_playing: bool,
+        beat: f64,
+        time_micros: i64,
+    }
+
+    struct OutputEvent {
+        tag: u8,
+        
+        timeline: TimelineData,
+        start_stop: StartStopData,
+        
+        num_peers: u32,
+        
+        iface_id: u32,
+        ip: [u8; 4],
+        port: u16,
+        bytes: Vec<u8>,
+        
+        time_micros: i64,
+    }
+
+    extern "Rust" {
+        type RustEngine;
+        
+        fn create_engine(node_id_val: u64) -> Box<RustEngine>;
+        
+        fn handle_packet(self: &mut RustEngine, iface_id: u32, from_ip: [u8; 4], from_port: u16, bytes: &[u8], now_micros: i64) -> Vec<OutputEvent>;
+        fn handle_timer(self: &mut RustEngine, now_micros: i64) -> Vec<OutputEvent>;
+        fn commit_app_state(self: &mut RustEngine, timeline: TimelineData, start_stop: StartStopData, now_micros: i64) -> Vec<OutputEvent>;
+        fn set_enabled(self: &mut RustEngine, enabled: bool, now_micros: i64) -> Vec<OutputEvent>;
+        fn add_interface(self: &mut RustEngine, iface_id: u32, ip: [u8; 4], port: u16) -> Vec<OutputEvent>;
+        fn remove_interface(self: &mut RustEngine, iface_id: u32) -> Vec<OutputEvent>;
+        fn handle_io_error(self: &mut RustEngine, iface_id: u32, error_kind: u8, now_micros: i64) -> Vec<OutputEvent>;
+        
+        fn get_timeline(self: &RustEngine) -> TimelineData;
+        fn get_start_stop(self: &RustEngine) -> StartStopData;
+    }
+}
+
+pub struct RustEngine {
+    engine: Engine,
+}
+
+fn create_engine(node_id_val: u64) -> Box<RustEngine> {
+    let mut node_id = NodeId([0; 8]);
+    node_id.0.copy_from_slice(&node_id_val.to_be_bytes());
+    Box::new(RustEngine {
+        engine: Engine::new(node_id),
+    })
+}
+
+fn to_timeline_data(tl: &Timeline) -> ffi::TimelineData {
+    ffi::TimelineData {
+        tempo: tl.tempo.to_tempo().0,
+        beat_origin: tl.beat_origin.to_beats(),
+        time_origin_micros: tl.time_origin.0,
+    }
+}
+
+fn to_start_stop_data(ss: &StartStopState) -> ffi::StartStopData {
+    ffi::StartStopData {
+        is_playing: ss.is_playing,
+        beat: ss.beat.to_beats(),
+        time_micros: ss.time.0,
+    }
+}
+
+fn default_timeline_data() -> ffi::TimelineData {
+    ffi::TimelineData { tempo: 120.0, beat_origin: 0.0, time_origin_micros: 0 }
+}
+fn default_start_stop_data() -> ffi::StartStopData {
+    ffi::StartStopData { is_playing: false, beat: 0.0, time_micros: 0 }
+}
+
+fn convert_outputs(outputs: Vec<Output>) -> Vec<ffi::OutputEvent> {
+    outputs.into_iter().map(|out| {
+        let mut evt = ffi::OutputEvent {
+            tag: 0,
+            timeline: default_timeline_data(),
+            start_stop: default_start_stop_data(),
+            num_peers: 0,
+            iface_id: 0,
+            ip: [0, 0, 0, 0],
+            port: 0,
+            bytes: Vec::new(),
+            time_micros: 0,
+        };
+        match out {
+            Output::StateChanged { state } => {
+                evt.tag = 1;
+                evt.timeline = to_timeline_data(&state.timeline);
+                evt.start_stop = to_start_stop_data(&state.start_stop);
+            }
+            Output::NumPeersChanged(n) => {
+                evt.tag = 2;
+                evt.num_peers = n;
+            }
+            Output::Send { iface_id, to, bytes } => {
+                evt.tag = 3;
+                evt.iface_id = iface_id.0;
+                evt.ip = to.ip;
+                evt.port = to.port;
+                evt.bytes = bytes;
+            }
+            Output::JoinMulticast { iface_id, group, port } => {
+                evt.tag = 4;
+                evt.iface_id = iface_id.0;
+                evt.ip = group;
+                evt.port = port;
+            }
+            Output::LeaveMulticast => {
+                evt.tag = 5;
+            }
+            Output::OpenUnicast { iface_id } => {
+                evt.tag = 6;
+                evt.iface_id = iface_id.0;
+            }
+            Output::SetTimer { at } => {
+                evt.tag = 7;
+                evt.time_micros = at.0;
+            }
+        }
+        evt
+    }).collect()
+}
+
+impl RustEngine {
+    fn handle_packet(&mut self, iface_id: u32, from_ip: [u8; 4], from_port: u16, bytes: &[u8], now_micros: i64) -> Vec<ffi::OutputEvent> {
+        let outputs = self.engine.handle_packet(
+            InterfaceId(iface_id),
+            SocketAddrPlain { ip: from_ip, port: from_port },
+            bytes,
+            HostTime(now_micros),
+        );
+        convert_outputs(outputs)
+    }
+
+    fn handle_timer(&mut self, now_micros: i64) -> Vec<ffi::OutputEvent> {
+        let outputs = self.engine.handle_timer(HostTime(now_micros));
+        convert_outputs(outputs)
+    }
+
+    fn commit_app_state(&mut self, timeline: ffi::TimelineData, start_stop: ffi::StartStopData, now_micros: i64) -> Vec<ffi::OutputEvent> {
+        let state = SessionState {
+            timeline: Timeline {
+                tempo: TempoWire::from_tempo(Tempo(timeline.tempo)),
+                beat_origin: MicroBeats::from_beats(timeline.beat_origin),
+                time_origin: HostTime(timeline.time_origin_micros),
+            },
+            start_stop: StartStopState {
+                is_playing: start_stop.is_playing,
+                beat: MicroBeats::from_beats(start_stop.beat),
+                time: HostTime(start_stop.time_micros),
+            }
+        };
+        let outputs = self.engine.commit_app_state(state, HostTime(now_micros));
+        convert_outputs(outputs)
+    }
+
+    fn set_enabled(&mut self, enabled: bool, now_micros: i64) -> Vec<ffi::OutputEvent> {
+        let outputs = self.engine.set_enabled(enabled, HostTime(now_micros));
+        convert_outputs(outputs)
+    }
+
+    fn add_interface(&mut self, iface_id: u32, ip: [u8; 4], port: u16) -> Vec<ffi::OutputEvent> {
+        let outputs = self.engine.add_interface(
+            InterfaceId(iface_id),
+            SocketAddrPlain { ip, port }
+        );
+        convert_outputs(outputs)
+    }
+
+    fn handle_io_error(&mut self, iface_id: u32, error_kind: u8, now_micros: i64) -> Vec<ffi::OutputEvent> {
+        let kind = match error_kind {
+            0 => tempo_sync_core::IoErrorKind::JoinMulticastFailed,
+            1 => tempo_sync_core::IoErrorKind::OpenUnicastFailed,
+            _ => tempo_sync_core::IoErrorKind::SendFailed,
+        };
+        let outputs = self.engine.handle_io_error(InterfaceId(iface_id), kind, HostTime(now_micros));
+        convert_outputs(outputs)
+    }
+
+    fn remove_interface(&mut self, iface_id: u32) -> Vec<ffi::OutputEvent> {
+        let outputs = self.engine.remove_interface(InterfaceId(iface_id));
+        convert_outputs(outputs)
+    }
+
+    fn get_timeline(&self) -> ffi::TimelineData {
+        to_timeline_data(&self.engine.state.timeline)
+    }
+
+    fn get_start_stop(&self) -> ffi::StartStopData {
+        to_start_stop_data(&self.engine.state.start_stop)
+    }
+}
diff --git a/content/browser/tempo_sync/rust_tempo_sync_engine.cc b/content/browser/tempo_sync/rust_tempo_sync_engine.cc
new file mode 100644
index 0000000000000..e5013bb546bd5
--- /dev/null
+++ b/content/browser/tempo_sync/rust_tempo_sync_engine.cc
@@ -0,0 +1,413 @@
+
+#pragma allow_unsafe_buffers
+#include "content/browser/tempo_sync/rust_tempo_sync_engine.h"
+
+#include <optional>
+#include <map>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/rand_util.h"
+#include "base/logging.h"
+#include "net/base/network_interfaces.h"
+#include "net/base/ip_address.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/io_buffer.h"
+#include "net/socket/udp_socket.h"
+#include "net/base/net_errors.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+#include "content/browser/tempo_sync/rust_tempo_sync_bridge.rs.h"
+
+namespace content {
+
+struct NetworkInfo {
+  uint32_t interface_index;
+  net::IPAddress address;
+  uint32_t prefix_length;
+};
+
+class RustTempoSyncEngine::Core : public base::RefCountedThreadSafe<Core> {
+ public:
+  Core(scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner,
+       base::WeakPtr<RustTempoSyncEngine> engine_weak)
+      : ui_task_runner_(ui_task_runner), engine_weak_(engine_weak) {}
+
+  void Init() {
+    uint64_t node_id = base::RandUint64();
+    rust_engine_.emplace(content::tempo_sync_bridge::create_engine(node_id));
+    
+    net::NetworkInterfaceList networks;
+    net::GetNetworkList(&networks, net::INCLUDE_HOST_SCOPE_VIRTUAL_INTERFACES);
+
+    bool has_ipv4 = false;
+    for (const auto& net : networks) {
+      if (net.address.IsIPv4()) {
+        has_ipv4 = true;
+        break;
+      }
+    }
+    if (!has_ipv4) {
+      networks.push_back(net::NetworkInterface(
+          "lo", "lo", 1, net::NetworkChangeNotifier::CONNECTION_UNKNOWN,
+          net::IPAddress::IPv4Localhost(), 8,
+          net::IP_ADDRESS_ATTRIBUTE_NONE));
+    }
+
+    multicast_socket_ = std::make_unique<net::UDPSocket>(net::DatagramSocket::DEFAULT_BIND, nullptr, net::NetLogSource());
+    int rv = multicast_socket_->Open(net::ADDRESS_FAMILY_IPV4);
+    if (rv != net::OK) LOG(ERROR) << "multicast Open failed: " << rv;
+
+    rv = multicast_socket_->AllowAddressSharingForMulticast();
+    if (rv != net::OK) LOG(ERROR) << "AllowAddressSharingForMulticast failed: " << rv;
+
+    rv = multicast_socket_->SetMulticastLoopbackMode(true);
+    if (rv != net::OK) LOG(ERROR) << "SetMulticastLoopbackMode failed: " << rv;
+
+    rv = multicast_socket_->SetMulticastTimeToLive(5);
+    if (rv != net::OK) LOG(ERROR) << "SetMulticastTimeToLive failed: " << rv;
+
+    rv = multicast_socket_->Bind(net::IPEndPoint(net::IPAddress::IPv4AllZeros(), 20808));
+    if (rv != net::OK) LOG(ERROR) << "multicast Bind failed: " << rv;
+
+    net::IPAddress mc_addr(224, 76, 78, 75);
+
+    for (const auto& net : networks) {
+      if (!net.address.IsIPv4()) continue;
+      
+      uint32_t iface_id = net.interface_index;
+      networks_.push_back({iface_id, net.address, net.prefix_length});
+      
+      multicast_socket_->SetMulticastInterface(iface_id);
+      rv = multicast_socket_->JoinGroup(mc_addr);
+      if (rv != net::OK) VLOG(1) << "JoinGroup skipped on " << net.address.ToString() << ": " << rv;
+      else VLOG(1) << "Joined multicast on interface " << net.address.ToString();
+
+      if (unicast_sockets_.find(iface_id) != unicast_sockets_.end()) continue;
+
+      auto unicast = std::make_unique<net::UDPSocket>(net::DatagramSocket::DEFAULT_BIND, nullptr, net::NetLogSource());
+      rv = unicast->Open(net::ADDRESS_FAMILY_IPV4);
+      if (rv != net::OK) { LOG(ERROR) << "unicast Open failed: " << rv; continue; }
+
+      unicast->SetMulticastLoopbackMode(true);
+      unicast->SetMulticastTimeToLive(5);
+      unicast->SetMulticastInterface(iface_id);
+
+      net::IPEndPoint local_ep(net.address, 0);
+      rv = unicast->Bind(local_ep);
+      if (rv != net::OK) { LOG(ERROR) << "unicast Bind failed on " << net.address.ToString() << ": " << rv; continue; }
+
+      net::IPEndPoint bound_ep;
+      unicast->GetLocalAddress(&bound_ep);
+      
+      unicast_sockets_[iface_id] = std::move(unicast);
+      ReadUnicast(iface_id);
+
+      std::array<uint8_t, 4> ip = {0,0,0,0};
+      auto bytes = bound_ep.address().bytes();
+      std::copy(bytes.begin(), bytes.end(), ip.begin());
+      ProcessEvents((*rust_engine_)->add_interface(iface_id, ip, bound_ep.port()));
+    }
+    
+    ReadMulticast();
+    ProcessEvents((*rust_engine_)->set_enabled(true, GetNowMicros()));
+  }
+
+  void SetTimeline(blink::mojom::TimelinePtr timeline) {
+    if (!rust_engine_) return;
+    content::tempo_sync_bridge::TimelineData tl_data;
+    tl_data.tempo = timeline->tempo_bpm;
+    tl_data.beat_origin = timeline->beat_origin;
+    tl_data.time_origin_micros = timeline->time_origin.since_origin().InMicroseconds();
+    
+    content::tempo_sync_bridge::StartStopData ss_data = (*rust_engine_)->get_start_stop();
+    ProcessEvents((*rust_engine_)->commit_app_state(tl_data, ss_data, GetNowMicros()));
+  }
+
+  void SetStartStop(blink::mojom::StartStopStatePtr state) {
+    if (!rust_engine_) return;
+    content::tempo_sync_bridge::StartStopData ss_data;
+    ss_data.is_playing = state->is_playing;
+    ss_data.beat = state->beat;
+    ss_data.time_micros = state->time.since_origin().InMicroseconds();
+    
+    content::tempo_sync_bridge::TimelineData tl_data = (*rust_engine_)->get_timeline();
+    ProcessEvents((*rust_engine_)->commit_app_state(tl_data, ss_data, GetNowMicros()));
+  }
+
+  void Shutdown() {
+    timer_.Stop();
+    multicast_socket_.reset();
+    unicast_sockets_.clear();
+    rust_engine_.reset();
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Core>;
+  ~Core() {}
+
+  int64_t GetNowMicros() {
+    return base::TimeTicks::Now().since_origin().InMicroseconds();
+  }
+
+  void ProcessEvents(const rust::Vec<content::tempo_sync_bridge::OutputEvent>& events) {
+    for (const auto& ev : events) {
+      switch (ev.tag) {
+        case 1: { // StateChanged
+          auto tl = blink::mojom::Timeline::New();
+          tl->tempo_bpm = ev.timeline.tempo;
+          tl->beat_origin = ev.timeline.beat_origin;
+          tl->time_origin = base::TimeTicks() + base::Microseconds(ev.timeline.time_origin_micros);
+
+          auto ss = blink::mojom::StartStopState::New();
+          ss->is_playing = ev.start_stop.is_playing;
+          ss->beat = ev.start_stop.beat;
+          ss->time = base::TimeTicks() + base::Microseconds(ev.start_stop.time_micros);
+
+          VLOG(1) << "StateChanged tempo=" << tl->tempo_bpm;
+          ui_task_runner_->PostTask(FROM_HERE,
+              base::BindOnce(&RustTempoSyncEngine::OnStateChanged, engine_weak_,
+                             std::move(tl), std::move(ss)));
+          break;
+        }
+        case 2: // NumPeersChanged
+          VLOG(1) << "NumPeersChanged peers=" << ev.num_peers;
+          ui_task_runner_->PostTask(FROM_HERE,
+              base::BindOnce(&RustTempoSyncEngine::OnNumPeersChanged, engine_weak_,
+                             ev.num_peers));
+          break;
+        case 3: { // Send
+          auto buf = base::MakeRefCounted<net::IOBufferWithSize>(ev.bytes.size());
+          memcpy(buf->data(), ev.bytes.data(), ev.bytes.size());
+          net::IPAddress addr(ev.ip[0], ev.ip[1], ev.ip[2], ev.ip[3]);
+          net::IPEndPoint ep(addr, ev.port);
+          
+          uint8_t payload_byte = ev.bytes.size() > 8 ? ev.bytes[8] : 0;
+          VLOG(1) << "Send iface=" << ev.iface_id << " to=" << ep.ToString() 
+                  << " len=" << ev.bytes.size() << " payload_byte=" << (int)payload_byte;
+
+          bool is_multicast = (addr == net::IPAddress(224, 76, 78, 75));
+          auto it = unicast_sockets_.find(ev.iface_id);
+          if (it == unicast_sockets_.end() && !unicast_sockets_.empty()) {
+            it = unicast_sockets_.begin();
+          }
+          if (it != unicast_sockets_.end() && it->second) {
+            int rv = it->second->SendTo(buf.get(), ev.bytes.size(), ep,
+                base::BindOnce(&Core::OnSendDone, this, is_multicast));
+            if (rv < 0 && rv != net::ERR_IO_PENDING) {
+              LOG(ERROR) << (is_multicast ? "multicast" : "unicast")
+                         << " SendTo failed synchronously: " << rv;
+            }
+          } else if (is_multicast && multicast_socket_) {
+            int rv = multicast_socket_->SendTo(buf.get(), ev.bytes.size(), ep,
+                base::BindOnce(&Core::OnSendDone, this, true));
+            if (rv < 0 && rv != net::ERR_IO_PENDING) {
+              LOG(ERROR) << "multicast SendTo failed synchronously: " << rv;
+            }
+          } else {
+            LOG(ERROR) << "Send dropped: no socket available for iface " << ev.iface_id;
+          }
+          break;
+        }
+        case 7: { // SetTimer
+          int64_t delay = ev.time_micros - GetNowMicros();
+          VLOG(1) << "SetTimer deadline_in=" << delay << "us";
+          if (delay < 0) delay = 0;
+          timer_.Start(FROM_HERE, base::Microseconds(delay),
+                       this, &Core::OnTimer);
+          break;
+        }
+      }
+    }
+  }
+
+  void OnTimer() {
+    if (rust_engine_) {
+      ProcessEvents((*rust_engine_)->handle_timer(GetNowMicros()));
+    }
+  }
+
+
+  void ReadMulticast() {
+    if (!multicast_socket_) return;
+    int rv;
+    do {
+      auto buf = base::MakeRefCounted<net::IOBufferWithSize>(65536);
+      rv = multicast_socket_->RecvFrom(
+          buf.get(), 65536, &recv_address_,
+          base::BindOnce(&Core::OnMulticastRead, this, buf));
+      if (rv > 0) {
+        ProcessMulticastRead(buf, rv);
+      }
+    } while (rv > 0);
+  }
+
+  void OnMulticastRead(scoped_refptr<net::IOBuffer> buf, int rv) {
+    if (rv > 0) {
+      ProcessMulticastRead(buf, rv);
+      ReadMulticast();
+    }
+  }
+
+  void ProcessMulticastRead(scoped_refptr<net::IOBuffer> buf, int rv) {
+    if (multicast_socket_ && rust_engine_) {
+      std::array<uint8_t, 4> ip = {0,0,0,0};
+      if (recv_address_.address().IsIPv4()) {
+        auto bytes = recv_address_.address().bytes();
+        std::copy(bytes.begin(), bytes.end(), ip.begin());
+      }
+      
+      uint32_t iface_id = 0;
+      for (const auto& net : networks_) {
+        if (net::IPAddressMatchesPrefix(recv_address_.address(), net.address, net.prefix_length)) {
+          iface_id = net.interface_index;
+          break;
+        }
+      }
+      if (iface_id == 0 && !networks_.empty()) {
+        iface_id = networks_.front().interface_index;
+      }
+      
+      uint8_t payload_byte = rv > 8 ? buf->data()[8] : 0;
+      VLOG(1) << "RecvMulticast iface=" << iface_id << " from=" << recv_address_.ToString() 
+              << " len=" << rv << " payload_byte=" << (int)payload_byte;
+
+      rust::Slice<const uint8_t> data(reinterpret_cast<const uint8_t*>(buf->data()), rv);
+      ProcessEvents((*rust_engine_)->handle_packet(
+          iface_id, ip, recv_address_.port(), data, GetNowMicros()));
+    }
+  }
+
+  void ReadUnicast(uint32_t iface_id) {
+    auto it = unicast_sockets_.find(iface_id);
+    if (it == unicast_sockets_.end() || !it->second) return;
+    int rv;
+    do {
+      auto buf = base::MakeRefCounted<net::IOBufferWithSize>(65536);
+      rv = it->second->RecvFrom(
+          buf.get(), 65536, &unicast_recv_addrs_[iface_id],
+          base::BindOnce(&Core::OnUnicastRead, this, iface_id, buf));
+      if (rv > 0) {
+        ProcessUnicastRead(iface_id, buf, rv);
+      }
+    } while (rv > 0);
+  }
+
+  void OnUnicastRead(uint32_t iface_id, scoped_refptr<net::IOBuffer> buf, int rv) {
+    if (rv > 0) {
+      ProcessUnicastRead(iface_id, buf, rv);
+      ReadUnicast(iface_id);
+    }
+  }
+
+  void ProcessUnicastRead(uint32_t iface_id, scoped_refptr<net::IOBuffer> buf, int rv) {
+    if (rust_engine_) {
+      net::IPEndPoint& recv_addr = unicast_recv_addrs_[iface_id];
+      std::array<uint8_t, 4> ip = {0,0,0,0};
+      if (recv_addr.address().IsIPv4()) {
+        auto bytes = recv_addr.address().bytes();
+        std::copy(bytes.begin(), bytes.end(), ip.begin());
+      }
+      
+      uint8_t payload_byte = rv > 8 ? buf->data()[8] : 0;
+      VLOG(1) << "RecvUnicast iface=" << iface_id << " from=" << recv_addr.ToString() 
+              << " len=" << rv << " payload_byte=" << (int)payload_byte;
+
+      rust::Slice<const uint8_t> data(reinterpret_cast<const uint8_t*>(buf->data()), rv);
+      ProcessEvents((*rust_engine_)->handle_packet(
+          iface_id, ip, recv_addr.port(), data, GetNowMicros()));
+    }
+  }
+
+  void OnSendDone(bool is_multicast, int rv) {
+    if (rv < 0) {
+      LOG(ERROR) << (is_multicast ? "multicast" : "unicast") << " async SendTo failed: " << rv;
+    }
+  }
+
+  scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner_;
+  base::WeakPtr<RustTempoSyncEngine> engine_weak_;
+  
+  std::optional<rust::Box<content::tempo_sync_bridge::RustEngine>> rust_engine_;
+  std::unique_ptr<net::UDPSocket> multicast_socket_;
+  std::map<uint32_t, std::unique_ptr<net::UDPSocket>> unicast_sockets_;
+  std::map<uint32_t, net::IPEndPoint> unicast_recv_addrs_;
+  net::IPEndPoint recv_address_;
+  base::OneShotTimer timer_;
+  std::vector<NetworkInfo> networks_;
+};
+
+// --- RustTempoSyncEngine ---
+
+RustTempoSyncEngine::RustTempoSyncEngine() : weak_factory_(this) {
+  timeline_ = blink::mojom::Timeline::New(120.0, 0.0, base::TimeTicks::Now());
+  start_stop_ = blink::mojom::StartStopState::New(false, 0.0, base::TimeTicks::Now());
+
+  engine_thread_ = std::make_unique<base::Thread>("TempoSyncEngineThread");
+  base::Thread::Options options;
+  options.message_pump_type = base::MessagePumpType::IO;
+  engine_thread_->StartWithOptions(std::move(options));
+
+  core_ = base::MakeRefCounted<Core>(
+      base::SingleThreadTaskRunner::GetCurrentDefault(),
+      weak_factory_.GetWeakPtr());
+
+  engine_thread_->task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&Core::Init, core_));
+}
+
+RustTempoSyncEngine::~RustTempoSyncEngine() {
+  engine_thread_->task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&Core::Shutdown, core_));
+  engine_thread_->Stop();
+}
+
+void RustTempoSyncEngine::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void RustTempoSyncEngine::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void RustTempoSyncEngine::SetTimeline(blink::mojom::TimelinePtr timeline) {
+  engine_thread_->task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&Core::SetTimeline, core_, timeline->Clone()));
+}
+
+void RustTempoSyncEngine::SetStartStop(blink::mojom::StartStopStatePtr state) {
+  engine_thread_->task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&Core::SetStartStop, core_, state->Clone()));
+}
+
+blink::mojom::TimelinePtr RustTempoSyncEngine::GetTimeline() const {
+  return timeline_->Clone();
+}
+
+blink::mojom::StartStopStatePtr RustTempoSyncEngine::GetStartStop() const {
+  return start_stop_->Clone();
+}
+
+uint32_t RustTempoSyncEngine::GetNumPeers() const {
+  return num_peers_;
+}
+
+void RustTempoSyncEngine::OnStateChanged(blink::mojom::TimelinePtr timeline, blink::mojom::StartStopStatePtr state) {
+  timeline_ = std::move(timeline);
+  start_stop_ = std::move(state);
+  for (auto& obs : observers_) {
+    obs.OnTimelineChanged(timeline_->Clone());
+    obs.OnStartStopChanged(start_stop_->Clone());
+  }
+}
+
+void RustTempoSyncEngine::OnNumPeersChanged(uint32_t num_peers) {
+  num_peers_ = num_peers;
+  for (auto& obs : observers_) {
+    obs.OnNumPeersChanged(num_peers_);
+  }
+}
+
+}  // namespace content
diff --git a/content/browser/tempo_sync/rust_tempo_sync_engine.h b/content/browser/tempo_sync/rust_tempo_sync_engine.h
new file mode 100644
index 0000000000000..7822679e9f20e
--- /dev/null
+++ b/content/browser/tempo_sync/rust_tempo_sync_engine.h
@@ -0,0 +1,48 @@
+#ifndef CONTENT_BROWSER_TEMPO_SYNC_RUST_TEMPO_SYNC_ENGINE_H_
+#define CONTENT_BROWSER_TEMPO_SYNC_RUST_TEMPO_SYNC_ENGINE_H_
+
+#include <memory>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/threading/thread.h"
+#include "content/browser/tempo_sync/tempo_sync_engine.h"
+
+namespace content {
+
+class RustTempoSyncEngine : public TempoSyncEngine {
+ public:
+  RustTempoSyncEngine();
+  ~RustTempoSyncEngine() override;
+
+  // TempoSyncEngine
+  void AddObserver(Observer* observer) override;
+  void RemoveObserver(Observer* observer) override;
+
+  void SetTimeline(blink::mojom::TimelinePtr timeline) override;
+  void SetStartStop(blink::mojom::StartStopStatePtr state) override;
+  blink::mojom::TimelinePtr GetTimeline() const override;
+  blink::mojom::StartStopStatePtr GetStartStop() const override;
+  uint32_t GetNumPeers() const override;
+
+ private:
+  class Core;
+
+  void OnStateChanged(blink::mojom::TimelinePtr timeline, blink::mojom::StartStopStatePtr state);
+  void OnNumPeersChanged(uint32_t num_peers);
+
+  base::ObserverList<Observer>::Unchecked observers_;
+  blink::mojom::TimelinePtr timeline_;
+  blink::mojom::StartStopStatePtr start_stop_;
+  uint32_t num_peers_ = 0;
+
+  std::unique_ptr<base::Thread> engine_thread_;
+  scoped_refptr<Core> core_;
+  
+  base::WeakPtrFactory<RustTempoSyncEngine> weak_factory_;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_TEMPO_SYNC_RUST_TEMPO_SYNC_ENGINE_H_
diff --git a/content/browser/tempo_sync/tempo_session_host.cc b/content/browser/tempo_sync/tempo_session_host.cc
new file mode 100644
index 0000000000000..cf6ca7ee261e4
--- /dev/null
+++ b/content/browser/tempo_sync/tempo_session_host.cc
@@ -0,0 +1,70 @@
+#include "content/browser/tempo_sync/tempo_session_host.h"
+#include "base/memory/ptr_util.h"
+#include "base/command_line.h"
+#include "content/browser/tempo_sync/fake_tempo_sync_engine.h"
+#include "content/browser/tempo_sync/rust_tempo_sync_engine.h"
+
+namespace content {
+
+namespace {
+const char kTempoSessionHostKey[] = "TempoSessionHostKey";
+}
+
+// static
+TempoSessionHost* TempoSessionHost::GetForBrowserContext(BrowserContext* context) {
+  if (!context->GetUserData(kTempoSessionHostKey)) {
+    context->SetUserData(kTempoSessionHostKey, std::make_unique<TempoSessionHost>());
+  }
+  return static_cast<TempoSessionHost*>(context->GetUserData(kTempoSessionHostKey));
+}
+
+TempoSessionHost::TempoSessionHost() {
+  std::string engine_type = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("tempo-sync-engine");
+  if (engine_type == "fake") {
+    engine_ = std::make_unique<FakeTempoSyncEngine>();
+  } else {
+    engine_ = std::make_unique<RustTempoSyncEngine>();
+  }
+  engine_->AddObserver(this);
+}
+
+TempoSessionHost::~TempoSessionHost() {
+  engine_->RemoveObserver(this);
+}
+
+void TempoSessionHost::AddClient(mojo::PendingReceiver<blink::mojom::TempoSession> receiver,
+                                 mojo::PendingRemote<blink::mojom::TempoSessionClient> client) {
+  receivers_.Add(this, std::move(receiver));
+  clients_.Add(std::move(client));
+}
+
+void TempoSessionHost::CommitTimeline(blink::mojom::TimelinePtr timeline) {
+  engine_->SetTimeline(std::move(timeline));
+}
+
+void TempoSessionHost::CommitStartStop(blink::mojom::StartStopStatePtr state) {
+  engine_->SetStartStop(std::move(state));
+}
+
+void TempoSessionHost::Close() {
+}
+
+void TempoSessionHost::OnTimelineChanged(blink::mojom::TimelinePtr timeline) {
+  for (auto& client : clients_) {
+    client->OnTimelineChanged(timeline->Clone());
+  }
+}
+
+void TempoSessionHost::OnStartStopChanged(blink::mojom::StartStopStatePtr state) {
+  for (auto& client : clients_) {
+    client->OnStartStopChanged(state->Clone());
+  }
+}
+
+void TempoSessionHost::OnNumPeersChanged(uint32_t num_peers) {
+  for (auto& client : clients_) {
+    client->OnNumPeersChanged(num_peers);
+  }
+}
+
+}  // namespace content
