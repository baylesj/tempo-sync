+module blink.mojom;
+
+import "mojo/public/mojom/base/time.mojom";
+
+struct Timeline {
+  double tempo_bpm;
+  double beat_origin;
+  mojo_base.mojom.TimeTicks time_origin;
+};
+
+struct StartStopState {
+  bool is_playing;
+  double beat;
+  mojo_base.mojom.TimeTicks time;
+};
+
+struct TempoSessionOptions {
+  double quantum;
+  bool start_stop_sync;
+};
+
+interface TempoSyncService {
+  RequestSession(TempoSessionOptions options, pending_remote<TempoSessionClient> client)
+      => (pending_remote<TempoSession>? session, Timeline? timeline, StartStopState? start_stop, uint32 num_peers, string? error_message);
+};
+
+interface TempoSession {
+  CommitTimeline(Timeline timeline);
+  CommitStartStop(StartStopState state);
+  Close();
+};
+
+interface TempoSessionClient {
+  OnTimelineChanged(Timeline timeline);
+  OnStartStopChanged(StartStopState state);
+  OnNumPeersChanged(uint32 num_peers);
+};
