+  double quantum() const { return quantum_; }
+
+  TempoSessionState* captureState(ExceptionState& exception_state);
+  TempoSessionState* captureState(BaseAudioContext* context, ExceptionState& exception_state);
+  void commitState(TempoSessionState* state, ExceptionState& exception_state);
+  void close();
+
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(numpeerschange, kNumpeerschange)
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(tempochange, kTempochange)
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(playingchange, kPlayingchange)
+
+  // EventTarget
+  const AtomicString& InterfaceName() const override;
