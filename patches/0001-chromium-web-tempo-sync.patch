@@ -0,0 +1,33 @@
+#ifndef CONTENT_BROWSER_TEMPO_SYNC_FAKE_TEMPO_SYNC_ENGINE_H_
+#define CONTENT_BROWSER_TEMPO_SYNC_FAKE_TEMPO_SYNC_ENGINE_H_
+
+#include "base/observer_list.h"
+#include "content/browser/tempo_sync/tempo_sync_engine.h"
+
+namespace content {
+
+class FakeTempoSyncEngine : public TempoSyncEngine {
+ public:
+  FakeTempoSyncEngine();
+  ~FakeTempoSyncEngine() override;
+
+  // TempoSyncEngine
+  void AddObserver(Observer* observer) override;
+  void RemoveObserver(Observer* observer) override;
+
+  void SetTimeline(blink::mojom::TimelinePtr timeline) override;
+  void SetStartStop(blink::mojom::StartStopStatePtr state) override;
+  blink::mojom::TimelinePtr GetTimeline() const override;
+  blink::mojom::StartStopStatePtr GetStartStop() const override;
+  uint32_t GetNumPeers() const override;
+
+ private:
+  base::ObserverList<Observer>::Unchecked observers_;
+  blink::mojom::TimelinePtr timeline_;
+  blink::mojom::StartStopStatePtr start_stop_;
+  uint32_t num_peers_ = 0;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_TEMPO_SYNC_FAKE_TEMPO_SYNC_ENGINE_H_
