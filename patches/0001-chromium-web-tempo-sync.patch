+#include "third_party/blink/renderer/modules/tempo_sync/tempo_session_state.h"
+
+#include <cmath>
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/timing/dom_window_performance.h"
+#include "third_party/blink/renderer/core/timing/window_performance.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+
+namespace blink {
+
+TempoSessionState::TempoSessionState(mojom::blink::TimelinePtr timeline,
+                                     mojom::blink::StartStopStatePtr start_stop,
+                                     base::TimeTicks host_time_origin,
+                                     double local_time_origin, double session_quantum)
+    : timeline_(std::move(timeline)),
+      start_stop_(std::move(start_stop)),
+      host_time_origin_(host_time_origin),
+      local_time_origin_(local_time_origin),
+      session_quantum_(session_quantum) {}
+
+double TempoSessionState::tempo() const {
+  return timeline_->tempo_bpm;
+}
+
+void TempoSessionState::setTempo(double bpm, double atTime) {
+  // To change tempo at atTime, we shift the time_origin and beat_origin
+  // to be exactly at atTime, then update the tempo.
+  base::TimeTicks host_time = LocalToHostTime(atTime);
+  double current_beat = BeatAtHostTime(host_time);
+
+  timeline_->tempo_bpm = bpm;
+  timeline_->time_origin = host_time;
+  timeline_->beat_origin = current_beat;
+}
+
+double TempoSessionState::beatAtTime(double time, double quantum) {
+  // quantum is unused for just calculating the beat, but it's part of the API.
+  return beatAtTime(time);
+}
+
+double TempoSessionState::beatAtTime(double time) {
+  return BeatAtHostTime(LocalToHostTime(time));
+}
+
+double TempoSessionState::phaseAtTime(double time, double quantum) {
+  double beat = beatAtTime(time);
+  if (quantum <= 0) return 0;
+  double phase = fmod(beat, quantum);
+  if (phase < 0) phase += quantum;
+  return phase;
+}
+
+double TempoSessionState::phaseAtTime(double time) {
+  return phaseAtTime(time, session_quantum_); // We will route the default quantum from TempoSession
+}
+
+double TempoSessionState::timeAtBeat(double beat, double quantum) {
+  return timeAtBeat(beat);
+}
+
+double TempoSessionState::timeAtBeat(double beat) {
+  return HostToLocalTime(HostTimeAtBeat(beat));
+}
+
+void TempoSessionState::requestBeatAtTime(double beat, double time, double quantum) {
+  // Preserve phase relative to the quantum by shifting the timeline so that
+  // the requested beat lands at the requested time rounded to the nearest phase-equivalent beat.
+  base::TimeTicks host_time = LocalToHostTime(time);
+  double current_beat_at_time = BeatAtHostTime(host_time);
+  
+  if (quantum > 0) {
+    double beat_diff = beat - current_beat_at_time;
+    double quantum_shifts = round(beat_diff / quantum);
+    double target_beat = current_beat_at_time + quantum_shifts * quantum;
+    
+    // Now we want target_beat to happen at host_time.
+    timeline_->beat_origin = target_beat;
+    timeline_->time_origin = host_time;
+  } else {
+    forceBeatAtTime(beat, time);
+  }
+}
+
+void TempoSessionState::requestBeatAtTime(double beat, double time) {
+  requestBeatAtTime(beat, time, session_quantum_);
+}
+
+void TempoSessionState::forceBeatAtTime(double beat, double time, double quantum) {
+  forceBeatAtTime(beat, time);
+}
+
+void TempoSessionState::forceBeatAtTime(double beat, double time) {
+  timeline_->beat_origin = beat;
+  timeline_->time_origin = LocalToHostTime(time);
+}
+
+bool TempoSessionState::isPlaying() const {
+  return start_stop_->is_playing;
+}
+
+double TempoSessionState::timeForIsPlaying() const {
+  return HostToLocalTime(start_stop_->time);
+}
+
+void TempoSessionState::setIsPlaying(bool playing, double atTime) {
+  base::TimeTicks host_time = LocalToHostTime(atTime);
+  start_stop_->is_playing = playing;
+  start_stop_->time = host_time;
+  start_stop_->beat = BeatAtHostTime(host_time);
+}
+
+mojom::blink::TimelinePtr TempoSessionState::CloneTimeline() const {
+  return timeline_->Clone();
+}
+
+mojom::blink::StartStopStatePtr TempoSessionState::CloneStartStop() const {
+  return start_stop_->Clone();
+}
+
+base::TimeTicks TempoSessionState::LocalToHostTime(double local_time) const {
+  return host_time_origin_ + base::Seconds(local_time - local_time_origin_);
+}
+
+double TempoSessionState::HostToLocalTime(base::TimeTicks host_time) const {
+  return local_time_origin_ + (host_time - host_time_origin_).InSecondsF();
+}
+
+double TempoSessionState::BeatAtHostTime(base::TimeTicks host_time) const {
+  double elapsed_seconds = (host_time - timeline_->time_origin).InSecondsF();
+  double beats_per_second = timeline_->tempo_bpm / 60.0;
+  return timeline_->beat_origin + elapsed_seconds * beats_per_second;
+}
+
+base::TimeTicks TempoSessionState::HostTimeAtBeat(double beat) const {
+  double beats_per_second = timeline_->tempo_bpm / 60.0;
+  double elapsed_seconds = (beat - timeline_->beat_origin) / beats_per_second;
+  return timeline_->time_origin + base::Seconds(elapsed_seconds);
+}
+
+}  // namespace blink
