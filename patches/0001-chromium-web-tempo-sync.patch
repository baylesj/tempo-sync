+#include "third_party/blink/renderer/modules/tempo_sync/tempo_sync.h"
+
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/renderer/bindings/modules/v8/v8_tempo_session_options.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/navigator.h"
+#include "third_party/blink/renderer/modules/tempo_sync/tempo_session.h"
+#include "third_party/blink/renderer/core/dom/dom_exception.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+
+namespace blink {
+
+TempoSync::TempoSync(Navigator* navigator)
+    : ExecutionContextLifecycleObserver(navigator->DomWindow()),
+      service_(navigator->DomWindow()) {}
+
+ScriptPromise<TempoSession> TempoSync::requestSession(
+    ScriptState* script_state,
+    const TempoSessionOptions* options,
+    ExceptionState& exception_state) {
+  if (!GetExecutionContext()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "Context is detached.");
+    return EmptyPromise();
+  }
+
+  if (!service_.is_bound()) {
+    GetExecutionContext()->GetBrowserInterfaceBroker().GetInterface(
+        service_.BindNewPipeAndPassReceiver(
+            GetExecutionContext()->GetTaskRunner(TaskType::kMiscPlatformAPI)));
+  }
+
+  auto* resolver = MakeGarbageCollected<ScriptPromiseResolver<TempoSession>>(
+      script_state, exception_state.GetContext());
+  auto promise = resolver->Promise();
+
+  auto mojom_options = mojom::blink::TempoSessionOptions::New();
+  mojom_options->quantum = options->quantum();
+  mojom_options->start_stop_sync = options->startStopSync();
+
+  auto* session = MakeGarbageCollected<TempoSession>(GetExecutionContext(), options);
+  auto client = session->BindNewPipeAndPassRemote();
+
+  service_->RequestSession(
+      std::move(mojom_options), std::move(client),
+      BindOnce(&TempoSync::OnSessionRequested, WrapPersistent(this),
+                    WrapPersistent(resolver), WrapPersistent(session)));
+
+  return promise;
+}
+
+void TempoSync::OnSessionRequested(
+    ScriptPromiseResolver<TempoSession>* resolver,
+    TempoSession* session,
+    mojo::PendingRemote<mojom::blink::TempoSession> session_remote,
+    mojom::blink::TimelinePtr timeline,
+    mojom::blink::StartStopStatePtr start_stop,
+    uint32_t num_peers,
+    const String& error_message) {
+  if (!resolver->GetExecutionContext() ||
+      resolver->GetExecutionContext()->IsContextDestroyed()) {
+    return;
+  }
+
+  if (!session_remote) {
+    resolver->Reject(MakeGarbageCollected<DOMException>(
+        DOMExceptionCode::kNotSupportedError, error_message));
+    return;
+  }
+
+  session->BindRemote(std::move(session_remote));
+  if (timeline) session->OnTimelineChanged(std::move(timeline));
+  if (start_stop) session->OnStartStopChanged(std::move(start_stop));
+  session->OnNumPeersChanged(num_peers);
+  resolver->Resolve(session);
+}
+
+void TempoSync::ContextDestroyed() {
+  service_.reset();
+}
+
+void TempoSync::Trace(Visitor* visitor) const {
+  visitor->Trace(service_);
+  ExecutionContextLifecycleObserver::Trace(visitor);
+  ScriptWrappable::Trace(visitor);
+}
+
+}  // namespace blink
