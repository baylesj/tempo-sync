+<!DOCTYPE html>
+<html>
+<head>
+<title>TempoSync Manual Test</title>
+</head>
+<body>
+<h1>TempoSync Manual Test</h1>
+<button id="requestBtn">Request Session</button>
+<button id="commitTempoBtn" disabled>Commit Tempo 100</button>
+<div id="output"></div>
+<script>
+let session = null;
+let af = null;
+
+document.getElementById('requestBtn').addEventListener('click', async () => {
+  try {
+    session = await navigator.tempoSync.requestSession({ quantum: 4, startStopSync: true });
+    document.getElementById('commitTempoBtn').disabled = false;
+    
+    session.ontempochange = () => console.log('Tempo changed');
+    session.onplayingchange = () => console.log('Playing changed');
+    session.onnumpeerschange = () => console.log('Num peers:', session.numPeers);
+    
+    if (!af) {
+      af = requestAnimationFrame(update);
+    }
+  } catch (e) {
+    console.error(e);
+  }
+});
+
+document.getElementById('commitTempoBtn').addEventListener('click', () => {
+  if (!session) return;
+  const state = session.captureState();
+  state.setTempo(100, performance.now() / 1000);
+  session.commitState(state);
+});
+
+function update() {
+  if (session) {
+    const state = session.captureState();
+    const time = performance.now() / 1000;
+    const tempo = state.tempo;
+    const beat = state.beatAtTime(time);
+    const phase = state.phaseAtTime(time);
+    
+    document.getElementById('output').innerHTML = `
+      Tempo: ${tempo.toFixed(2)} bpm<br>
+      Beat: ${beat.toFixed(2)}<br>
+      Phase: ${phase.toFixed(2)}<br>
+      Playing: ${state.isPlaying}<br>
+    `;
+  }
+  af = requestAnimationFrame(update);
+}
+</script>
+<script>document.getElementById("requestBtn").click();</script></body>
+</html>
