+#include "third_party/blink/renderer/core/timing/dom_window_performance.h"
+#include "third_party/blink/renderer/core/timing/window_performance.h"
+#include "third_party/blink/renderer/modules/tempo_sync/tempo_session_state.h"
+#include "third_party/blink/renderer/modules/webaudio/audio_context.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+
+namespace blink {
+
+TempoSession::TempoSession(ExecutionContext* context,
+                           const TempoSessionOptions* options)
+    : ExecutionContextLifecycleObserver(context),
+      remote_(context),
+      receiver_(this, context) {
+  quantum_ = options->quantum();
+}
+
+TempoSession::~TempoSession() = default;
+
+mojo::PendingRemote<mojom::blink::TempoSessionClient>
+TempoSession::BindNewPipeAndPassRemote() {
+  return receiver_.BindNewPipeAndPassRemote(
+      GetExecutionContext()->GetTaskRunner(TaskType::kMiscPlatformAPI));
+}
+
+void TempoSession::BindRemote(
+    mojo::PendingRemote<mojom::blink::TempoSession> remote) {
+  remote_.Bind(
+      std::move(remote),
+      GetExecutionContext()->GetTaskRunner(TaskType::kMiscPlatformAPI));
+}
+
+TempoSessionState* TempoSession::captureState(ExceptionState& exception_state) {
+  return captureState(nullptr, exception_state);
+}
+
+TempoSessionState* TempoSession::captureState(BaseAudioContext* context, ExceptionState& exception_state) {
+  if (!latest_timeline_ || !latest_start_stop_) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError, "Session unseeded");
+    return nullptr;
+  }
+
+  base::TimeTicks host_time_origin;
+  double local_time_origin;
+
+  AudioContext* audio_context = nullptr;
+  if (context && context->HasRealtimeConstraint()) {
+    audio_context = static_cast<AudioContext*>(context);
+  }
+  if (audio_context) {
+    auto pos = audio_context->GetOutputPositionForTempoSync();
+    if (pos.second.is_null()) {
+      local_time_origin = audio_context->currentTime();
+      host_time_origin = base::TimeTicks::Now();
+    } else {
+      local_time_origin = pos.first;
+      host_time_origin = pos.second;
+    }
+  } else {
+    LocalDOMWindow* window = To<LocalDOMWindow>(GetExecutionContext());
+    WindowPerformance* performance = DOMWindowPerformance::performance(*window);
+    host_time_origin = base::TimeTicks::Now();
+    local_time_origin = performance->MonotonicTimeToDOMHighResTimeStamp(host_time_origin) / 1000.0;
+  }
+
+  return MakeGarbageCollected<TempoSessionState>(
+      latest_timeline_->Clone(), latest_start_stop_->Clone(),
+      host_time_origin, local_time_origin, quantum_);
+}
+
+void TempoSession::commitState(TempoSessionState* state, ExceptionState& exception_state) {
+  if (!remote_.is_bound()) {
+    return;
+  }
+  remote_->CommitTimeline(state->CloneTimeline());
+  remote_->CommitStartStop(state->CloneStartStop());
+}
+
+void TempoSession::close() {
+  if (remote_.is_bound()) {
+    remote_->Close();
+    remote_.reset();
+  }
+  receiver_.reset();
+}
+
+const AtomicString& TempoSession::InterfaceName() const {
+  return event_target_names::kTempoSession;
+}
+
+ExecutionContext* TempoSession::GetExecutionContext() const {
+  return ExecutionContextLifecycleObserver::GetExecutionContext();
+}
+
+void TempoSession::OnTimelineChanged(mojom::blink::TimelinePtr timeline) {
+  bool tempo_changed = false;
+  if (!latest_timeline_ || latest_timeline_->tempo_bpm != timeline->tempo_bpm) {
+    tempo_changed = true;
+  }
+  latest_timeline_ = std::move(timeline);
+  
+  if (tempo_changed) {
+    DispatchEvent(*Event::Create(event_type_names::kTempochange));
+  }
+}
+
+void TempoSession::OnStartStopChanged(mojom::blink::StartStopStatePtr state) {
+  bool playing_changed = false;
+  if (!latest_start_stop_ || latest_start_stop_->is_playing != state->is_playing) {
+    playing_changed = true;
+  }
+  latest_start_stop_ = std::move(state);
+
+  if (playing_changed) {
+    DispatchEvent(*Event::Create(event_type_names::kPlayingchange));
+  }
+}
+
+void TempoSession::OnNumPeersChanged(uint32_t num_peers) {
+  if (num_peers_ != num_peers) {
+    num_peers_ = num_peers;
+    DispatchEvent(*Event::Create(event_type_names::kNumpeerschange));
+  }
+}
+
+void TempoSession::ContextDestroyed() {
+  remote_.reset();
+  receiver_.reset();
+}
+
+void TempoSession::Trace(Visitor* visitor) const {
+  visitor->Trace(remote_);
+  visitor->Trace(receiver_);
+  EventTarget::Trace(visitor);
+  ExecutionContextLifecycleObserver::Trace(visitor);
+}
+
+}  // namespace blink
